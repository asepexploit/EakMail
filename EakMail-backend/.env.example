# EakMail backend configuration. Copy to .env and fill. Never commit .env.
# Local-first: dashboard/API bind to 127.0.0.1 by default (FR-10).

# --- Server ---
HOST=127.0.0.1
PORT=8787
NODE_ENV=development

# --- Database / Redis ---
DATABASE_URL=postgresql://eakmail:eakmail@127.0.0.1:5432/eakmail?schema=public
REDIS_URL=redis://127.0.0.1:6379

# --- Security ---
# 32-byte key, base64 or hex, used for AES-256-GCM at-rest encryption of secrets.
ENCRYPTION_KEY=change-me-32-bytes-minimum-secret-key
SESSION_SECRET=change-me-session-cookie-secret

# --- Telegram (MTProto user account, GramJS) ---
# From https://my.telegram.org. Used by the Session Manager. Do NOT connect live during build.
TELEGRAM_API_ID=0
TELEGRAM_API_HASH=

# --- Storefront bot (Telegraf) ---
# Optional here; the token is normally set from the dashboard (bot_config, encrypted).
STOREFRONT_BOT_TOKEN=

# --- Pakasir payment ---
PAKASIR_BASE_URL=https://pakasir.com
PAKASIR_SLUG=
PAKASIR_API_KEY=
PAKASIR_WEBHOOK_SECRET=

# --- Behaviour flags ---
# When true, external integrations use mocks and never connect live (safe for build/CI).
USE_MOCKS=true
