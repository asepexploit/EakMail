{
  "name": "@eakmail/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --env-file=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\"",
    "test": "vitest run",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "seed": "tsx --env-file=.env src/db/seed.ts"
  },
  "dependencies": {
    "@eakmail/shared-types": "workspace:*",
    "@fastify/cookie": "^9.3.1",
    "@fastify/websocket": "^10.0.1",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^5.20.0",
    "argon2": "^0.41.1",
    "bullmq": "^5.15.0",
    "dotenv": "^18.0.5",
    "fastify": "^4.28.1",
    "ioredis": "^5.4.1",
    "otplib": "^12.0.1",
    "pg": "^8.23.1",
    "pino": "^9.4.0",
    "qrcode": "^1.5.4",
    "telegraf": "^4.16.3",
    "telegram": "^2.24.11",
    "undici": "^6.19.8",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "@types/qrcode": "^1.5.6",
    "prisma": "^5.20.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.2",
    "vitest": "^2.1.0"
  }
}
